# Copy to .env and adjust. Loaded automatically via python-dotenv.

# Flask / JWT secrets - change for any non-local deployment
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too

# --- Database selection -------------------------------------------------
# Leave DATABASE_URL unset to use the bundled zero-config SQLite database.
# For the MySQL production target, uncomment and edit the line below:
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/linkedin_jobs?charset=utf8mb4

# Backend listening port
PORT=5000
